# Base URL backend `perumahan` (Hono), TANPA trailing slash.
# Kosong = seluruh data diambil dari fixture (`src/lib/api/fixtures.ts`),
# jadi repo ini tetap bisa jalan sebelum backend tersedia.
OMAHE_API_BASE_URL=

# Set "1" HANYA setelah epic UNIT-04 (`GET /public/units`) dan DEVELOPER-01
# (`GET /public/developers`) landed di repo `perumahan`. Selama "0"/kosong,
# detail perumahan sudah pakai API asli (endpoint itu memang sudah ada) tapi
# pencarian & direktori developer masih fixture.
OMAHE_API_SEARCH=0

# Timeout fetch ke backend, milidetik.
OMAHE_API_TIMEOUT_MS=8000

# SESI-OMAHE-01 — cara uji LOKAL varian agen (mode fixture, tanpa backend):
# set "1" lalu buka situs dengan cookie `session` apa pun (mis. lewat devtools
# `document.cookie = 'session=uji'`) → header menampilkan agen contoh
# OMHA-A0001 "Agen Contoh" dan tombol WhatsApp menjadi "Daftarkan Pembeli"
# (dialog `/api/agen-lead` fixture; nomor 081200000409 → simulasi 409
# "sudah didaftarkan agen lain"). Diabaikan saat `OMAHE_API_BASE_URL`
# terisi (mode API asli membaca sesi dari backend) dan di build produksi.
OMAHE_FIXTURE_AGEN=0

# Base URL app `perumahan` yang melayani `/ajukan/:slug` — tujuan SEMUA CTA
# booking. Salah isi di sini = seluruh CTA booking mati.
PUBLIC_BOOKING_BASE_URL=http://localhost:5173

# Site key PUBLIK Cloudflare Turnstile untuk halaman bayar tagihan
# `/bayar/:token` (TAGIHAN-02). Secret key-nya TIDAK di sini — hanya di
# backend `perumahan` (env `TURNSTILE_SECRET_KEY`, diverifikasi server-side
# lewat siteverify). Kosong saat dev → otomatis pakai test key Cloudflare
# (selalu lolos) supaya alur bayar bisa dicoba tanpa konfigurasi.
PUBLIC_TURNSTILE_SITE_KEY=
